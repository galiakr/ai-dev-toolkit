#!/usr/bin/env bash
# Full-repo pass — slower, catches what staged-only pre-commit can't.
set -uo pipefail

fail=0

# Same file list as CI's validate-shell-scripts job. The hooks have no .sh
# extension, so they're named explicitly.
shell_files=(scripts/*.sh .githooks/pre-commit .githooks/pre-push fixtures/skillspector/test-ci-loop.sh)

echo "Checking skills (structure + security patterns, shared with CI)..."
./scripts/check-skills.sh || fail=1

if command -v shellcheck >/dev/null 2>&1; then
  echo "Running shellcheck on scripts and hooks..."
  shellcheck "${shell_files[@]}" || fail=1
else
  echo "shellcheck not installed locally — skipping (CI still runs it)."
fi

echo "Running bootstrap smoke checks..."
if ! ./scripts/test-bootstrap.sh >/dev/null; then
  echo "[error] scripts/test-bootstrap.sh failed — run it directly to see which check."
  fail=1
fi

echo "Running SkillSpector CI loop regression check..."
if ! ./fixtures/skillspector/test-ci-loop.sh >/dev/null; then
  echo "[error] fixtures/skillspector/test-ci-loop.sh failed — run it directly to see which check."
  fail=1
fi

if command -v actionlint >/dev/null 2>&1; then
  echo "Running actionlint on git/workflows/*.yml..."
  actionlint git/workflows/*.yml || fail=1
else
  echo "actionlint not installed locally — skipping (CI still runs it)."
fi

if command -v gitleaks >/dev/null 2>&1; then
  echo "Running gitleaks..."
  gitleaks detect --no-banner || fail=1
else
  echo "gitleaks not installed locally — skipping (CI still runs it)."
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-push found issues above. Fix them before pushing — never skip this with --no-verify."
fi

exit $fail
