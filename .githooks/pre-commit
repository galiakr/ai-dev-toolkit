#!/usr/bin/env bash
# Fast, staged-files-only checks. The full pass runs in pre-push and CI.
# The rules themselves live in scripts/check-skills.sh, shared with
# pre-push and CI so the same content gets the same verdict everywhere.
set -uo pipefail

if ! ./scripts/check-skills.sh --staged; then
  echo ""
  echo "pre-commit found issues in staged SKILL.md files above. Fix them — never skip this with --no-verify."
  exit 1
fi
